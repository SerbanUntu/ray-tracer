# Command: `doxygen Doxyfile`.
# Output location: docs/html.

PROJECT_NAME           = "raytracer"
PROJECT_BRIEF          = "Parallel Ray Tracer written from scratch (no graphics API)."
OUTPUT_DIRECTORY       = docs

INPUT                  = apps common mandelbrot raytracer
FILE_PATTERNS          = *.cpp *.h *.hpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
INHERIT_DOCS           = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Requires graphviz `dot`
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

# Do not fail CI
QUIET                  = YES
WARN_AS_ERROR          = NO
